# Copy this file to .env and add credentials locally. Never commit real values.
OPENAI_API_KEY=your_openai_api_key
# Select a vision-capable model available to your account.
OPENAI_MODEL=your_vision_capable_model
# YouTube Data API v3 key (optional: fallback catalog is used if not provided)
YOUTUBE_API_KEY=your_youtube_data_api_key
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
